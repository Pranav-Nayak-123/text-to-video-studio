# ---------------------------------------------------------------------------
# Text to Video Studio - environment
#
# Every value here is OPTIONAL. With none of them set the pipeline still
# produces a complete video: it uses the built-in deterministic story analyser,
# procedural visuals, and locally installed text-to-speech.
# ---------------------------------------------------------------------------

# Enables two optional providers:
#   - model-backed story analysis (a richer reading than the built-in analyser)
#   - photoreal scene plates via the image API
# Without it, or without credit on the account, the pipeline falls back
# automatically and says so.
OPENAI_API_KEY=

# Optional: alternate OpenAI-compatible endpoint.
# OPENAI_BASE_URL=https://api.openai.com/v1

# Optional: model used for story analysis.
# STORY_MODEL=gpt-4o-mini

# Python interpreter used for edge-tts neural voices.
# Defaults to "python" on PATH. Windows SAPI is used automatically if edge-tts
# is unavailable.
# PYTHON_BIN=python

# Port for the local studio.
PORT=5178
