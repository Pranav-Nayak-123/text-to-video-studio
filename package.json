{
  "name": "text-to-video-studio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Turns any story into a narrated video: derives characters, scenes, dialogue and timing from plain text, then generates visuals, voices and a rendered MP4.",
  "license": "MIT",
  "author": "Pranav Nayak",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Pranav-Nayak-123/text-to-video-studio.git"
  },
  "keywords": [
    "text-to-video",
    "video-generation",
    "remotion",
    "story-analysis",
    "nlp",
    "text-to-speech",
    "ffmpeg",
    "generative-media"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "story": "node scripts/story.mjs",
    "assets": "node scripts/assets.mjs",
    "render": "node engine/render/render.mjs",
    "verify": "node engine/render/verify.mjs",
    "studio": "remotion studio",
    "test": "node --test \"tests/*.test.mjs\"",
    "server": "node server/index.js",
    "start": "node scripts/start.mjs"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.520",
    "@remotion/cli": "4.0.520",
    "@remotion/fonts": "^4.0.520",
    "@remotion/google-fonts": "4.0.520",
    "@remotion/media-utils": "4.0.520",
    "@remotion/renderer": "4.0.520",
    "express": "5.2.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "remotion": "4.0.520"
  },
  "devDependencies": {
    "@types/react": "19.2.0",
    "typescript": "5.9.3"
  }
}
